proxy_set_header Host $host;
proxy_set_header Proxy "";
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header ${REAL_IP_PROXY_HEADER} $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Port ${NGINX_X_FORWARDED_PORT};
proxy_set_header X-Forwarded-Proto ${NGINX_X_FORWARDED_PROTO};

proxy_http_version 1.1;
proxy_buffering off;

# Hindari 502 "upstream sent too big header" ketika aplikasi mengirim header Inertia/cookie lebih besar.
proxy_buffer_size 64k;
proxy_buffers 16 64k;
proxy_busy_buffers_size 128k;

proxy_connect_timeout 60s;
proxy_read_timeout 36000s;
proxy_redirect off;

proxy_pass_header Authorization;
proxy_pass ${BACKEND};

SET_REAL_IP_FROM
real_ip_header ${REAL_IP_HEADER};
real_ip_recursive ${REAL_IP_RECURSIVE};

