{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.3" }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/css/(.*)", "dest": "/public/css/$1" },
        { "src": "/js/(.*)", "dest": "/public/js/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/favicon.png", "dest": "/public/favicon.png" },
        { "src": "/favicon.svg", "dest": "/public/favicon.svg" },
        { "src": "/apple-touch-icon.png", "dest": "/public/apple-touch-icon.png" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/storage/(.*)", "dest": "/public/storage/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "MediStock",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "database",
        "SESSION_CONNECTION": "pgsql",
        "SESSION_LIFETIME": "120",
        "SESSION_COOKIE": "medistock_session",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require"
    },
    "build": {
        "env": {
            "APP_NAME": "MediStock",
            "APP_ENV": "production",
            "APP_DEBUG": "false",
            "CACHE_STORE": "array",
            "SESSION_DRIVER": "database",
            "SESSION_CONNECTION": "pgsql",
            "SESSION_LIFETIME": "120",
            "QUEUE_CONNECTION": "sync",
            "LOG_CHANNEL": "stderr",
            "DB_CONNECTION": "pgsql",
            "DB_SSLMODE": "require"
        }
    }
}
